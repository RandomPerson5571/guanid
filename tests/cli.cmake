file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${CAPTURE}" OUTPUT_FILE "${WORK}/capture.csv" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Callback capture failed: ${status}")
endif()
execute_process(COMMAND "${ANALYZE}" "${WORK}/capture.csv" --out "${WORK}/gains.json"
    --plot-dir "${WORK}/plots" --velocity-tau 0.1 --position-omega 8 RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "C++ analysis failed: ${status}")
endif()
file(READ "${WORK}/gains.json" report)
if(NOT report MATCHES "flywheel" OR NOT report MATCHES "velocity_feedback" OR NOT report MATCHES "position_feedback")
    message(FATAL_ERROR "Missing report fields")
endif()
if(NOT EXISTS "${WORK}/plots/flywheel.svg" OR NOT EXISTS "${WORK}/plots/flywheel.csv")
    message(FATAL_ERROR "Missing diagnostics")
endif()
file(WRITE "${WORK}/bad.csv" "run_id,test,direction,time_s,motor,units,voltage,position,velocity\n0,dynamic,forward,0,motor,m,nan,0,0\n")
execute_process(COMMAND "${ANALYZE}" "${WORK}/bad.csv" --out "${WORK}/bad.json" RESULT_VARIABLE status)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "Malformed CSV was not rejected")
endif()
